# Minimal public demo: no credentials required. Copy to backend/.env if needed.
BACKEND_HOST=127.0.0.1
PORT=4173
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Leave PUBLIC_ORIGIN unset locally; for hosting set the exact HTTPS origin.
# PUBLIC_ORIGIN=https://your-game.example

# Optional hosted identity-linked Circle wallets. Set all Circle fields together.
# Obtain TEST credentials and a TEST wallet set for ETH-SEPOLIA.
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=
# CIRCLE_WALLET_SET_ID=
# ASHENKIN_AUTH_SECRET=
# ASHENKIN_AUTH_ORIGIN=https://your-game.example
ASHENKIN_KEEPER_DB_FILE=db/keepers.sqlite
# Optional email sign-in; wallet sign-in can operate without SMTP.
# ASHENKIN_SMTP_URL=
# ASHENKIN_EMAIL_FROM=

# Dedicated daily faucet: opt in only after configuring/funding its separate wallet.
ASHENKIN_GAS_FAUCET_ENABLED=false
ASHENKIN_GAS_FAUCET_AMOUNT=0.002
# ASHENKIN_GAS_FAUCET_KEY_FILE=/run/secrets/ashenkin-faucet.json
# ASHENKIN_GAS_FAUCET_EXPECTED_ADDRESS=

# Optional public-result settlement sponsor. JSON key-file property: pk.
# CHIMERA_SETTLEMENT_KEY_FILE=/run/secrets/ashenkin-settlement.json
# CHIMERA_SETTLEMENT_EXPECTED_ADDRESS=
CHIMERA_SETTLEMENT_MAX_GWEI=3

# Optional dedicated interactive signer; expected address is required when enabled.
# Uses the same private {"pk":"0x..."}
# file format as the legacy settlement signer. Keep it distinct from the
# offline worker and faucet; the backend/db journal must persist across restarts.
# Without this signer the conservative shared-signer fallback remains active.
# ASHENKIN_INTERACTIVE_KEY_FILE=/run/secrets/ashenkin-interactive.json
# ASHENKIN_INTERACTIVE_EXPECTED_ADDRESS=

# Living Xenos needs Circle/auth configured above, plus the deployed encounter contract.
# ASHENKIN_ENCOUNTERS_ADDRESS=0xf2aAf9a3dc7b1a58013117f4712ee6214D8F73E4
ASHENKIN_LIFE_WORKER=false
ASHENKIN_LIFE_DAILY_ETH=0.005
ASHENKIN_LIFE_MAX_GWEI=0.1

# Legacy bounded starter sponsorship is off unless both fields are explicitly set.
# ASHENKIN_CIRCLE_STARTER_ETH=
# ASHENKIN_STARTER_MINT_LIMIT=
